# Ubuntu 24.04 based sandbox image for AI Optimization Arena
# Provides isolated, secure environment for compiling and running C++ code

FROM ubuntu:24.04

# Prevent interactive prompts during package installation
ENV DEBIAN_FRONTEND=noninteractive

# Install base dependencies and repositories
RUN apt-get update && apt-get install -y \
    software-properties-common \
    wget \
    curl \
    gnupg \
    lsb-release \
    ca-certificates \
    time \
    && rm -rf /var/lib/apt/lists/*

# Install task-maker-rust
RUN mkdir -p /etc/apt/keyrings \
    && curl https://artifacts.lucaversari.it/signing-key.asc | tee /etc/apt/keyrings/task-maker-rust.asc > /dev/null \
    && echo "deb [signed-by=/etc/apt/keyrings/task-maker-rust.asc] https://artifacts.lucaversari.it/olimpiadi-informatica/task-maker-rust/latest/deb/noble /" | tee /etc/apt/sources.list.d/task-maker-rust.list \
    && apt-get update -qq && apt-get install -y -qq task-maker-rust \
    && ln -s /usr/bin/task-maker-rust /usr/local/bin/tmc || true

# Add LLVM repository for clang versions
RUN wget -qO- https://apt.llvm.org/llvm-snapshot.gpg.key | tee /etc/apt/trusted.gpg.d/apt.llvm.org.asc \
    && add-apt-repository "deb http://apt.llvm.org/noble/ llvm-toolchain-noble-18 main" \
    && add-apt-repository "deb http://apt.llvm.org/noble/ llvm-toolchain-noble-17 main"

# Install GCC 14
RUN apt-get update -qq && apt-get install -y -qq \
    gcc-14 \
    g++-14 \
    && rm -rf /var/lib/apt/lists/*

# Install Clang 18
RUN apt-get update -qq && apt-get install -y -qq \
    clang-18 \
    && rm -rf /var/lib/apt/lists/*

# Create symlinks for convenience (but compilers will be called by full name)
RUN update-alternatives --install /usr/bin/gcc gcc /usr/bin/gcc-14 100 \
    && update-alternatives --install /usr/bin/g++ g++ /usr/bin/g++-14 100

# Create harness directory
RUN mkdir -p /opt/harness

# Copy and compile test harness
COPY test_harness.cpp /opt/harness/
RUN g++-14 -O2 -o /opt/harness/run_test /opt/harness/test_harness.cpp \
    && chmod +x /opt/harness/run_test

# Create workspace directory
RUN mkdir -p /workspace && chmod 777 /workspace

# Create a non-root user for running untrusted code
RUN groupadd -r sandboxuser && useradd -r -g sandboxuser -d /workspace sandboxuser

# Set working directory
WORKDIR /workspace

# Default command
CMD ["/bin/bash"]
